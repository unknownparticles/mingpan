# 命盘 PWA AI 配置（复制为 .env.local 后填写）
# 参考 one_min_ceo：默认推荐 SiliconFlow

# 通用（任意 OpenAI 兼容厂商）
# VITE_AI_API_KEY=
# VITE_AI_BASE_URL=
# VITE_AI_MODEL=
# VITE_AI_ENABLE_THINKING=false

# SiliconFlow（推荐）
VITE_SILICONFLOW_API_KEY=
VITE_SILICONFLOW_MODEL=Qwen/Qwen2.5-14B-Instruct

# DeepSeek
# VITE_DEEPSEEK_API_KEY=
# VITE_DEEPSEEK_MODEL=deepseek-chat

# MiniMax
# VITE_MINIMAX_API_KEY=
# VITE_MINIMAX_MODEL=MiniMax-M2.5

# CF Auth 登录器（跨域用 Bearer Token）
VITE_AUTH_BASE_URL=https://login.alunapi.top
VITE_LOGIN_BASE_URL=https://login.alunapi.top
VITE_REGISTER_BASE_URL=https://register.alunapi.top

# CF AI 平台（登录后默认）
VITE_AI_SERVICE_BASE_URL=https://ai.alunapi.top
